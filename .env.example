# Copy to .env.local (local) or set in your host's dashboard (production).

# --- Database and admin (required) ---

# Postgres connection string. Production: a Neon database (neon.tech or the Vercel
# Marketplace); use its pooled connection string. Local: `npm run db:dev` starts a
# Postgres on port 5433 that matches the value below.
DATABASE_URL=postgres://kainos:kainos@localhost:5433/kainos

# The one password for /admin. Changing it signs everyone out.
ADMIN_PASSWORD=
# Signs the admin session cookie: 32+ random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Vercel Blob read-write token (Vercel dashboard → Storage → Blob). Where photos
# uploaded in the admin are stored. Without it they go to ./uploads on the server's
# disk, which only works on a server with a persistent disk (not on Vercel).
BLOB_READ_WRITE_TOKEN=

# --- Domain and search engines ---

# The live domain, with https and no trailing slash. Canonical URLs, hreflang links,
# the sitemap, Open Graph images and structured data are all built from it.
# Search engines are told NOT to index the site until this is set.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to 1 on a staging/demo server to keep it out of search results.
# (Vercel preview deployments are kept out automatically.)
NEXT_PUBLIC_NOINDEX=

# Search Console ownership tokens: paste only the content="..." value of the
# <meta> tag each console gives you. Comma-separate several tokens if needed.
# Google Search Console → Add property → URL prefix → "HTML tag"
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → "HTML Meta Tag" (msvalidate.01)
BING_SITE_VERIFICATION=
# Yandex Webmaster (optional)
YANDEX_SITE_VERIFICATION=
